{
  "kind": "collectionType",
  "collectionName": "newsletter_signups",
  "info": {
    "singularName": "newsletter-signup",
    "pluralName": "newsletter-signups",
    "displayName": "Newsletter signup",
    "description": "Public email sign-ups for the xBlog newsletter."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "email": {
      "type": "email",
      "required": true,
      "unique": true
    },
    "name": {
      "type": "string",
      "maxLength": 80
    },
    "source": {
      "type": "string",
      "maxLength": 60,
      "default": "homepage"
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "required": true
    }
  }
}
