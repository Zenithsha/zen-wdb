{
  "kind": "collectionType",
  "collectionName": "notifications",
  "info": {
    "singularName": "notification",
    "pluralName": "notifications",
    "displayName": "Notification",
    "description": "Per-user notifications: comments, reactions, mentions, post approvals/rejections, etc."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "type": {
      "type": "enumeration",
      "enum": [
        "comment",
        "reply",
        "reaction",
        "mention",
        "approval",
        "rejection",
        "submission",
        "announcement"
      ],
      "required": true
    },
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "message": {
      "type": "text",
      "maxLength": 500
    },
    "link": {
      "type": "string",
      "maxLength": 500
    },
    "read": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "recipient": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "actor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
