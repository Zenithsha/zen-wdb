# Copy this file to `.env` and replace EVERY value below with one of
# your own. `.env` is git-ignored. Never commit real secrets.
#
# Quick way to generate a strong secret from your terminal:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"

# ── Server ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=1337

# ── Strapi secrets (regenerate each one — DO NOT reuse these strings) ─
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
ENCRYPTION_KEY=replace-me
JWT_SECRET=replace-me

# ── Database ──────────────────────────────────────────────────────────
# `sqlite` (zero-setup, single file) OR `postgres` (recommended for prod).
DATABASE_CLIENT=postgres

# Postgres connection (only used when DATABASE_CLIENT=postgres):
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=xBlogDB
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-me
DATABASE_SSL=false

# SQLite file (only used when DATABASE_CLIENT=sqlite):
DATABASE_FILENAME=.tmp/data.db

# ── Optional: auto-promote the first admin on boot ────────────────────
# If set, any user with this email will be promoted to the `admin` role
# the next time Strapi starts. Useful for the very first deployment.
# SEED_ADMIN_EMAIL=you@example.com

# ── Optional: extend JWT lifetime (default 30d, see config/plugins.js) ─
# JWT_EXPIRES_IN=30d
